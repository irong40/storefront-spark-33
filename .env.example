# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Square (publishable / frontend)
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=

# Web Push (VAPID public key only — private key lives in Supabase secrets)
VITE_VAPID_PUBLIC_KEY=

# Renovation cutover: the America/New_York date walk-in pickup resumes and
# delivery pauses. Optional — defaults to 2026-09-16 in src/config/checkout.ts.
# Vite inlines env vars at build time, so changing this requires a REDEPLOY.
VITE_PICKUP_RESUMES_DATE=2026-09-16
