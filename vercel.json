{
  "redirects": [
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [{ "type": "host", "value": "impressivejb.com" }],
      "destination": "https://www.impressivejb.com/$1",
      "permanent": true
    },
    { "source": "/menus", "destination": "/products", "permanent": true },
    { "source": "/contact-8", "destination": "/contact", "permanent": true },
    { "source": "/gift-card-balance", "destination": "/gift-cards/balance", "permanent": true },
    { "source": "/products/3-pack-10", "destination": "/products", "permanent": true },
    { "source": "/products/3-pack-16", "destination": "/products", "permanent": true },
    { "source": "/products/5-pack", "destination": "/products", "permanent": true },
    { "source": "/products/gallon-juice", "destination": "/products", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|\\.well-known/)[^.]*)", "destination": "/index.html" }
  ]
}
